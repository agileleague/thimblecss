{
  "name": "thimblecss",
  "version": "4.0.0",
  "description": "A nimble micro CSS Framework",
  "main": "dist/thimble.css",
  "style": "dist/thimble.css",
  "jsdelivr": "dist/thimble.min.css",
  "unpkg": "dist/thimble.min.css",
  "exports": {
    ".": "./dist/thimble.css",
    "./min": "./dist/thimble.min.css",
    "./css/*": "./css/*"
  },
  "files": [
    "dist",
    "css",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "lightningcss --bundle css/thimble.css -o dist/thimble.css && lightningcss --bundle --minify css/thimble.css -o dist/thimble.min.css",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agileleague/thimblecss.git"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.33.0"
  },
  "keywords": [
    "css",
    "flexbox",
    "grid",
    "front-end",
    "framework",
    "microframework",
    "html",
    "html5",
    "mobile-first",
    "responsive",
    "normalize",
    "web"
  ],
  "author": "Drew Nolte <drew@agileleague.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agileleague/thimblecss/issues"
  },
  "homepage": "https://thimblecss.com"
}
